{
  "expo": {
    "name": "findsites",
    "slug": "findsites",
    "version": "1.1.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f0f0f5"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.glaulher.findsites",
      "versionCode": 21
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./src/plugins/android-manifest.plugin.js",
      [
        "expo-updates",
        {
          "username": "glaulher"
        }
      ],
      [
        "expo-asset",
        {
          "assets": [
            "./assets/images"
          ]
        }
      ],
      [
        "react-native-map-link"
      ],
      "expo-font",
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": true,
          "android": {
            "enableFTS": false,
            "useSQLCipher": false
          },
          "ios": {
            "customBuildFlags": [
              "-DSQLITE_ENABLE_DBSTAT_VTAB=1 -DSQLITE_ENABLE_SNAPSHOT=1"
            ]
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "110f32a7-0bfb-4dc4-b67e-69ee3acd2a0a"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
